{
  "name": "dotsbr-motion",
  "version": "1.0.0",
  "description": "dotsbr 15s motion graphics: real Censo 2022 dots in WebGL, captured frame by frame",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "data": "node scripts/extract.mjs",
    "stats": "node scripts/stats.mjs race 10 && node scripts/rio_stats.mjs",
    "sound": "node scripts/soundtrack.mjs",
    "render": "node scripts/render.mjs",
    "render:vertical": "node scripts/render.mjs --w 1080 --h 1920",
    "stills": "node scripts/render.mjs --stills 0.5,1.6,3.8,5,6.4,8.2,10.2,12,14.9"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "pbf": "^3.3.0",
    "playwright-core": "^1.63.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
