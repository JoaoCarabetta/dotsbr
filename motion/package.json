{
  "name": "dotsbr-motion",
  "version": "1.0.0",
  "description": "dotsbr motion graphics (37 s + five election shorts): real Censo 2022 dots in WebGL, captured frame by frame",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "data": "node scripts/extract.mjs",
    "stats": "node scripts/stats.mjs race 10 && node scripts/rio_stats.mjs",
    "sound": "node scripts/soundtrack.mjs",
    "render": "node scripts/render.mjs --workers 2 --target-mib 28.5",
    "render:vertical": "node scripts/render.mjs --workers 2 --target-mib 28.5 --w 1080 --h 1920",
    "stills": "node scripts/render.mjs --stills 1.2,2.9,4.6,8,11.9,14.6,19,24.5,30,33.4,35.8",
    "stats:elections": "node scripts/election_stats.mjs",
    "score": "node scripts/score.mjs",
    "render:shorts": "for s in povo duascores bolso fe seuestado; do node scripts/score.mjs --story $s && node scripts/render.mjs --story $s --w 1080 --h 1920 --workers 2 --target-mib 28.5 || exit 1; done"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "pbf": "^3.3.0",
    "playwright-core": "^1.63.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
